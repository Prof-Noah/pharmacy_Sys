<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="sample.login.RegisterController"
      alignment="CENTER_LEFT"
      spacing="15"
      styleClass="register-root">
    <padding>
        <Insets top="40" right="48" bottom="40" left="48" />
    </padding>

    <Label text="Create your account" styleClass="form-title" />
    <Label text="Enter your pharmacy details and choose a password with at least 8 characters." wrapText="true" styleClass="form-subtitle" />

    <VBox spacing="7" styleClass="field-group">
        <Label text="Pharmacy name" styleClass="field-label" />
        <TextField fx:id="pharmacyNameField" promptText="Enter your pharmacy name" styleClass="login-input" />
    </VBox>

    <VBox spacing="7" styleClass="field-group">
        <Label text="Username" styleClass="field-label" />
        <TextField fx:id="usernameField" promptText="Choose a username" styleClass="login-input" />
    </VBox>

    <VBox spacing="7" styleClass="field-group">
        <Label text="Password" styleClass="field-label" />
        <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="login-input" />
    </VBox>

    <VBox spacing="7" styleClass="field-group">
        <Label text="Confirm password" styleClass="field-label" />
        <PasswordField fx:id="confirmPasswordField" promptText="Enter the password again" onAction="#handleRegister" styleClass="login-input" />
    </VBox>

    <Label fx:id="messageLabel" text=" " wrapText="true" styleClass="login-message" />
    <Button text="Create account" onAction="#handleRegister" maxWidth="Infinity" styleClass="login-button" />
</VBox>
